---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { image: ImageMetadata; alt: string; caption: string }[];
  featured?: boolean;
  columns?: 2 | 3;
}
const { items, featured = false, columns = 2 } = Astro.props;
---
<div class:list={['project-gallery', { featured, 'three-columns': columns === 3 }]}>
  {items.map(({ image, alt, caption }) => (
    <figure>
      <a href={image.src} aria-label={`View full image: ${alt}`}>
        <Image src={image} alt={alt} width={1200} widths={[400, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 60vw" format="webp" loading="lazy" />
      </a>
      <figcaption>{caption}</figcaption>
    </figure>
  ))}
</div>
<style>
  .project-gallery { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  figure { min-width: 0; margin: 0; }
  a { display: block; overflow: hidden; border-radius: 10px; background: #b5be9f; }
  a:focus-visible { outline: 3px solid var(--text); outline-offset: 5px; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: contain; }
  .featured figure:first-child { grid-column: 1 / -1; }
  .featured figure:first-child img { aspect-ratio: auto; max-height: 660px; }
  figcaption { margin-top: 12px; color: var(--muted); font-size: .875rem; line-height: 1.6; }
  @media (max-width: 900px) { .three-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .project-gallery { grid-template-columns: 1fr; gap: 24px; } }
</style>
