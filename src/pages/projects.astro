---
import SiteLayout from '../layouts/SiteLayout.astro';
import MediaGallery from '../components/MediaGallery.astro';
import campus from '../../assets/RITES/c5066725-b8cd-4903-a32b-27428971d7b2.png';
import floor from '../../assets/RITES/floor material.png';
import wall from '../../assets/RITES/wall material.png';
import mascotMesh from '../../assets/hostiggo/WhatsApp Image 2026-10-13 at 21.30.06.jpeg';
import mascot from '../../assets/hostiggo/WhatsApp Image 2026-10-14 at 23.15.46.jpeg';
const ritesImages = [
  { image: campus, alt: 'Campus dining area recreated with colourful tables and seating', caption: 'RITES / Recreating the campus, one space at a time.' },
  { image: floor, alt: 'Green tiled floor material preview', caption: 'Material development / Campus flooring.' },
  { image: wall, alt: 'Textured masonry wall material preview', caption: 'Material development / Campus walls.' },
];
const hostiggoImages = [
  { image: mascotMesh, alt: 'Hostiggo mascot mesh being modelled in Blender', caption: 'Character development / Building the mascot in Blender.' },
  { image: mascot, alt: 'White horned Hostiggo mascot with blue eyes', caption: 'Character development / The mascot with colour and surface detail.' },
];
---
<SiteLayout title="Current projects | BoreBit Labs" description="Explore RITES, our campus-set zombie-survival game, and our media and advertising work for Hostiggo.">
  <section class="container page-heading"><span class="eyebrow">Current projects / BoreBit Labs</span><h1>Something is taking shape.</h1><p>A campus reimagined for survival, and creative support for a growing startup. Here's what we're building now.</p></section>
  <section class="container story-section" aria-labelledby="rites-title">
    <div class="story-heading"><span class="section-label">Game development</span><h2 id="rites-title">RITES</h2></div>
    <div class="story-body"><p>We're rebuilding the IIIT Delhi campus in Blender and Unreal Engine for RITES, a zombie-survival game set on campus. Familiar spaces become the setting for a new survival experience.</p>
    </div>
    <MediaGallery items={ritesImages} featured />
  </section>
  <section class="container story-section" aria-labelledby="hostiggo-title">
    <div class="story-heading"><span class="section-label">Media and advertising</span><h2 id="hostiggo-title">Marketing for Hostiggo</h2></div>
    <div class="story-body"><p>We're helping Hostiggo with its media and advertising needs, supporting the startup with creative content that communicates its brand and reaches its audience.</p></div>
    <MediaGallery items={hostiggoImages} />
  </section>
</SiteLayout>
