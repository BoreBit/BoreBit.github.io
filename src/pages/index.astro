---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="BoreBit Labs | Animation, games & interactive experiences"
  description="BoreBit Labs is an independent creative studio making animation, games, and interactive experiences."
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title" data-character-stage>
      <div class="hero-top container">
        <span class="hero-kicker"><span class="kicker-dot"></span> Independent creative studio</span>
        <span class="hero-index">Animation / Games / Interactive</span>
      </div>

      <div class="hero-intro">
        <p class="eyebrow">BoreBit Labs — ideas in motion</p>
        <h1 id="hero-title">Make it <em>move.</em></h1>
        <p>We build worlds, motion, and moments worth remembering.</p>
      </div>

      <div class="orbit" aria-hidden="true"></div>
      <div class="orbit orbit-small" aria-hidden="true"></div>
      <div class="character-canvas" data-character-canvas aria-hidden="true"></div>
      <p class="character-status" data-character-status role="status">Loading character…</p>

      <nav class="orbit-nav" aria-label="Explore the studio">
        <a class="orbit-link about-link" href="#about"><span class="link-number">01</span><span>About us</span><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a class="orbit-link work-link" href="#work"><span class="link-number">02</span><span>Previous work</span><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a class="orbit-link showcase-link" href="#showcase"><span class="link-number">03</span><span>Showcase</span><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a class="orbit-link projects-link" href="#projects"><span class="link-number">04</span><span>Current projects</span><span class="link-arrow" aria-hidden="true">↗</span></a>
        <a class="orbit-link community-link" href="#community"><span class="link-number">05</span><span>Community</span><span class="link-arrow" aria-hidden="true">↗</span></a>
      </nav>

      <div class="hero-bottom container">
        <span>Move your cursor to say hello</span>
        <a href="#about">Scroll to explore <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="section about-section container" id="about" aria-labelledby="about-title">
      <div class="section-meta"><span>01 / About us</span><span>Built with curiosity</span></div>
      <div class="about-grid">
        <h2 id="about-title">We make the<br /><em>imagined</em> tangible.</h2>
        <div class="section-copy">
          <p>BoreBit Labs is a creative studio working across animation, games, and interactive media. We bring visual craft and technical thinking together to make ideas feel alive.</p>
          <a class="text-link" href="/studio">Get to know the studio <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="discipline-list" aria-label="Our disciplines"><span>Animation</span><span>Game development</span><span>Interactive experiences</span></div>
    </section>

    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-meta"><span>02 / Previous work</span><span>What we make</span></div>
        <div class="section-heading-row">
          <h2 id="work-title">Made to be<br /><em>experienced.</em></h2>
          <p>From stories in motion to things you can play, our work connects a strong idea with the details that make it memorable.</p>
        </div>
        <div class="work-grid">
          <a class="work-card motion-card" href="/work">
            <span class="work-card-top">01 / Motion</span>
            <span class="work-card-art motion-art" aria-hidden="true"><span>M</span></span>
            <span class="work-card-bottom"><strong>Animation & visual storytelling</strong><span aria-hidden="true">↗</span></span>
          </a>
          <a class="work-card play-card" href="/work">
            <span class="work-card-top">02 / Play</span>
            <span class="work-card-art play-art" aria-hidden="true"><span>P</span></span>
            <span class="work-card-bottom"><strong>Games & interactive worlds</strong><span aria-hidden="true">↗</span></span>
          </a>
        </div>
        <a class="text-link work-more" href="/work">Explore our work <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section showcase-section container" id="showcase" aria-labelledby="showcase-title">
      <div class="section-meta"><span>03 / Showcase</span><span>Our creative lens</span></div>
      <div class="showcase-panel">
        <span class="showcase-mark" aria-hidden="true">✳</span>
        <div>
          <p class="eyebrow">A little bit of everything we love</p>
          <h2 id="showcase-title">Craft in every<br />frame. <em>Feeling</em> in every click.</h2>
          <p>Visual worlds, expressive characters, and interactions that invite people in.</p>
        </div>
        <span class="showcase-foot">BoreBit / Creative studio</span>
      </div>
    </section>

    <section class="section projects-section container" id="projects" aria-labelledby="projects-title">
      <div class="section-meta"><span>04 / Current projects</span><span>In the lab</span></div>
      <div class="projects-grid">
        <div>
          <h2 id="projects-title">Always building<br /><em>what’s next.</em></h2>
          <p>Our current focus spans character, motion, and play. New work is taking shape; the best ideas begin with an open conversation.</p>
          <a class="text-link" href="/contact">Start a project with us <span aria-hidden="true">↗</span></a>
        </div>
        <div class="focus-list" aria-label="Areas of focus">
          <div><span>01</span><strong>Character & motion</strong><span aria-hidden="true">↗</span></div>
          <div><span>02</span><strong>Playable concepts</strong><span aria-hidden="true">↗</span></div>
          <div><span>03</span><strong>Creative technology</strong><span aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

    <section class="community-section" id="community" aria-labelledby="community-title">
      <div class="container community-inner">
        <div class="section-meta"><span>05 / Community</span><span>Come make something</span></div>
        <div class="community-grid">
          <h2 id="community-title">Good ideas grow<br /><em>together.</em></h2>
          <div>
            <p>We believe the most interesting work happens when different minds meet. Bring a brief, a question, or a wild idea—we’d love to hear it.</p>
            <a class="community-cta" href="/contact">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  import { mountHeroCharacter } from '../scripts/heroCharacter';

  const stage = document.querySelector<HTMLElement>('[data-character-stage]');
  if (stage) mountHeroCharacter(stage);
</script>

<style>
  .home { overflow: hidden; }
  .hero { position: relative; min-height: min(850px, calc(100svh - 76px)); min-height: max(700px, min(850px, calc(100svh - 76px))); isolation: isolate; overflow: hidden; background: #faf9f4; }
  .hero::before { content: ''; position: absolute; width: 44rem; height: 44rem; left: 50%; top: 47%; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(255, 221, 91, .26), rgba(255, 221, 91, .08) 46%, transparent 70%); pointer-events: none; }
  .hero-top, .hero-bottom { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .hero-top { padding-top: 28px; }
  .kicker-dot { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--accent); vertical-align: 1px; }
  .hero-intro { position: absolute; z-index: 3; top: 11%; left: max(5%, calc((100% - 1180px) / 2)); width: min(390px, 31%); text-align: left; pointer-events: none; }
  .eyebrow { margin: 0 0 14px; color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .hero-intro h1 { margin: 0; font-size: clamp(3.5rem, 5.6vw, 5.7rem); line-height: .98; letter-spacing: -.07em; }
  h1 em, h2 em { font-style: normal; color: #d9a900; }
  .hero-intro > p:last-child { margin: 18px 0 0; color: var(--muted); font-size: clamp(.9rem, 1.2vw, 1rem); }
  .orbit { position: absolute; z-index: 0; top: 52%; left: 50%; width: min(620px, 62vw); aspect-ratio: 1; transform: translate(-50%, -50%); border: 1px solid rgba(140, 128, 89, .17); border-radius: 50%; pointer-events: none; }
  .orbit-small { width: min(440px, 44vw); border-style: dashed; border-color: rgba(140, 128, 89, .13); }
  .character-canvas { position: absolute; z-index: 1; inset: 0; pointer-events: none; }
  .character-canvas :global(canvas) { display: block; width: 100%; height: 100%; }
  .character-status { position: absolute; z-index: 2; top: 52%; left: 50%; transform: translate(-50%, -50%); color: var(--muted); font-size: .8rem; }
  .orbit-nav { position: absolute; z-index: 4; inset: 0; max-width: 1300px; margin: auto; pointer-events: none; }
  .orbit-link { position: absolute; display: inline-flex; align-items: center; gap: 18px; min-width: 190px; padding: 15px 17px; border: 1px solid #e4e0d2; border-radius: 6px; background: rgba(255, 255, 255, .9); box-shadow: 0 12px 40px rgba(55, 50, 27, .05); color: var(--text); font-size: .87rem; font-weight: 650; white-space: nowrap; pointer-events: auto; transition: background .2s, border-color .2s, transform .2s, box-shadow .2s; }
  .orbit-link:hover, .orbit-link:focus-visible { transform: translateY(-4px); border-color: var(--accent); background: #fff4bc; box-shadow: 0 16px 38px rgba(105, 83, 14, .12); }
  .link-number { color: #a99c79; font-size: .66rem; font-weight: 700; }
  .link-arrow { margin-left: auto; font-size: 1rem; }
  .about-link { top: 42%; left: 5%; }
  .work-link { top: 42%; right: 5%; }
  .showcase-link { top: 66%; left: 9%; }
  .projects-link { top: 66%; right: 9%; }
  .community-link { bottom: 4%; left: 50%; transform: translateX(-50%); }
  .community-link:hover, .community-link:focus-visible { transform: translate(-50%, -4px); }
  .hero-bottom { position: absolute; right: 0; bottom: 27px; left: 0; }
  .hero-bottom a { color: var(--text); }
  .hero-bottom a span { margin-left: 8px; font-size: 1rem; }
  .section { scroll-margin-top: 90px; padding-top: 112px; padding-bottom: 112px; }
  .section-meta { display: flex; justify-content: space-between; gap: 20px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .section h2, .community-section h2 { margin: 0; font-size: clamp(2.8rem, 5vw, 5.6rem); line-height: 1.03; letter-spacing: -.065em; }
  .about-grid, .section-heading-row, .projects-grid, .community-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 8%; align-items: end; margin-top: 72px; }
  .section-copy p, .section-heading-row p, .projects-grid p, .community-grid p { margin: 0 0 28px; color: var(--muted); font-size: 1.08rem; line-height: 1.75; }
  .text-link { display: inline-flex; gap: 28px; align-items: center; padding-bottom: 7px; border-bottom: 1px solid var(--text); font-size: .88rem; font-weight: 700; }
  .text-link:hover { color: #a78000; border-color: #a78000; }
  .discipline-list { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 72px; }
  .discipline-list span { padding: 10px 15px; border: 1px solid var(--line); border-radius: 100px; color: var(--muted); font-size: .77rem; font-weight: 600; }
  .work-section { background: #f5f3ea; }
  .section-heading-row { align-items: end; }
  .section-heading-row p { max-width: 360px; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 58px; }
  .work-card { display: flex; min-height: 430px; flex-direction: column; padding: 22px; border: 1px solid #e5e0d3; background: #fff; transition: transform .2s, box-shadow .2s; }
  .work-card:hover { transform: translateY(-5px); box-shadow: 0 20px 38px rgba(44, 39, 18, .08); }
  .work-card-top { color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .work-card-art { display: grid; flex: 1; place-items: center; margin: 22px 0; overflow: hidden; }
  .work-card-art span { color: rgba(36, 34, 25, .84); font-size: clamp(8rem, 22vw, 18rem); font-weight: 800; line-height: 1; letter-spacing: -.15em; }
  .motion-art { background: radial-gradient(circle at 65% 35%, #fff7c4 0 16%, transparent 16.2%), repeating-linear-gradient(120deg, transparent 0 24px, rgba(202, 155, 0, .11) 25px 26px), #f8e79d; }
  .play-art { background: radial-gradient(circle at 50% 50%, transparent 0 28%, rgba(34, 33, 24, .13) 28.2% 28.5%, transparent 28.7% 43%, rgba(34, 33, 24, .13) 43.2% 43.5%, transparent 43.7%), #eae8df; }
  .work-card-bottom { display: flex; justify-content: space-between; gap: 15px; align-items: center; font-size: 1.05rem; }
  .work-card-bottom > span { font-size: 1.3rem; }
  .work-more { margin-top: 28px; }
  .showcase-panel { position: relative; display: flex; min-height: 520px; flex-direction: column; justify-content: center; margin-top: 46px; padding: clamp(35px, 6vw, 85px); overflow: hidden; background: #f6d94f; }
  .showcase-panel::after { content: ''; position: absolute; width: 560px; height: 560px; right: -130px; top: -150px; border: 1px solid rgba(56, 51, 22, .2); border-radius: 50%; box-shadow: 0 0 0 70px rgba(255,255,255,.12), 0 0 0 140px rgba(255,255,255,.09); pointer-events: none; }
  .showcase-panel > div { position: relative; z-index: 1; max-width: 880px; }
  .showcase-panel h2 { font-size: clamp(2.7rem, 5.3vw, 5.6rem); }
  .showcase-panel h2 em { color: #fff; }
  .showcase-panel > div > p:last-child { max-width: 440px; margin: 24px 0 0; font-size: 1rem; line-height: 1.65; }
  .showcase-mark { position: absolute; top: 30px; right: 40px; font-size: 2rem; }
  .showcase-foot { position: absolute; right: 40px; bottom: 32px; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .projects-grid { align-items: start; }
  .projects-grid p { max-width: 520px; margin-top: 30px; }
  .focus-list { border-top: 1px solid var(--line); }
  .focus-list > div { display: grid; grid-template-columns: 34px 1fr 20px; gap: 14px; align-items: center; min-height: 90px; border-bottom: 1px solid var(--line); }
  .focus-list span { color: var(--muted); font-size: .7rem; }
  .focus-list strong { font-size: 1rem; }
  .community-section { scroll-margin-top: 90px; background: #f9e77d; }
  .community-inner { padding-top: 90px; padding-bottom: 110px; }
  .community-section .section-meta { border-color: rgba(65, 57, 17, .3); }
  .community-grid { align-items: end; }
  .community-grid h2 em { color: #fff; }
  .community-grid p { color: #4b452e; }
  .community-cta { display: inline-flex; min-width: 170px; justify-content: space-between; gap: 30px; padding: 15px 19px; background: var(--text); color: #fff; font-size: .88rem; font-weight: 700; }
  .community-cta:hover { background: #4c4222; }

  @media (max-width: 900px) {
    .hero { min-height: 760px; }
    .hero-intro { top: 10%; width: 240px; }
    .orbit-link { min-width: 155px; gap: 10px; padding: 12px; font-size: .78rem; }
    .about-link { left: 3%; } .work-link { right: 3%; }
    .showcase-link { left: 5%; } .projects-link { right: 5%; }
  }
  @media (max-width: 700px) {
    .hero { min-height: 0; padding-bottom: 34px; }
    .hero-top { padding-top: 24px; }
    .hero-index { display: none; }
    .hero-intro { position: relative; top: auto; left: auto; width: auto; margin: 54px 20px 0; text-align: center; }
    .hero-intro h1 { font-size: clamp(3.5rem, 13vw, 5rem); }
    .orbit, .orbit-small { top: 390px; width: 330px; }
    .orbit-small { width: 250px; }
    .character-canvas { top: 170px; bottom: auto; height: 440px; }
    .character-status { top: 385px; }
    .orbit-nav { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 430px 20px 0; }
    .orbit-link, .community-link { position: static; min-width: 0; width: 100%; transform: none; }
    .orbit-link:hover, .orbit-link:focus-visible, .community-link:hover, .community-link:focus-visible { transform: translateY(-3px); }
    .community-link { grid-column: 1 / -1; }
    .hero-bottom { position: relative; bottom: auto; margin-top: 30px; }
    .hero-bottom > span { display: none; }
    .hero-bottom a { margin-left: auto; }
    .section { padding-top: 80px; padding-bottom: 80px; }
    .about-grid, .section-heading-row, .projects-grid, .community-grid { grid-template-columns: 1fr; gap: 30px; margin-top: 45px; }
    .section-copy p, .section-heading-row p, .projects-grid p, .community-grid p { max-width: 590px; }
    .discipline-list { margin-top: 48px; }
    .work-grid { grid-template-columns: 1fr; }
    .work-card { min-height: 360px; }
    .showcase-panel { min-height: 460px; }
  }
  @media (max-width: 420px) {
    .orbit-link { gap: 8px; padding: 11px 9px; font-size: .72rem; }
    .link-number { font-size: .6rem; }
    .hero-bottom { display: none; }
    .section-meta span:last-child { display: none; }
  }
</style>
