---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="BoreBit Labs | Animation & Game Development Studio"
  description="BoreBit Labs is an animation and game development studio creating cinematic experiences, gameplay systems, and production support for ambitious brands and teams."
>
  <section class="hero container">
    <div class="hero-copy">
      <div class="eyebrow">Animation · Games · Interactive media</div>
      <h1>Build the next unforgettable experience.</h1>
      <p class="lead">
        BoreBit Labs is a creative studio crafting cinematic animation, gameplay systems, and
        technical production support for teams that need bold motion and memorable play.
      </p>
      <div class="button-row">
        <a class="button primary" href="/contact">Start a project</a>
        <a class="button secondary" href="/services">Explore services</a>
      </div>
      <div class="stats" aria-label="Company stats">
        <div><strong>8+</strong><span>Years crafting worlds</span></div>
        <div><strong>40+</strong><span>Projects shipped</span></div>
        <div><strong>24/7</strong><span>Creative partnership</span></div>
      </div>
    </div>
    <div class="hero-visual" aria-label="BoreBit Labs project dashboard preview">
      <div class="visual-top"><span>● ● ●</span><span>Launch Lab</span></div>
      <div class="visual-grid">
        <div class="chart" aria-hidden="true"></div>
        <div class="metrics">
          <div><span>Engagement</span><strong>92%</strong></div>
          <div><span>Retention</span><strong>4.8×</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-links container" aria-label="Explore BoreBit Labs">
    <a href="/services"><span>01 / Services</span><strong>Animation, games, and production</strong><span class="arrow">↗</span></a>
    <a href="/studio"><span>02 / Studio</span><strong>How we take ideas from brief to build</strong><span class="arrow">↗</span></a>
    <a href="/work"><span>03 / Work</span><strong>What we make and where we focus</strong><span class="arrow">↗</span></a>
  </section>
</SiteLayout>

<style>
  .hero {
    min-height: 620px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 52px;
    padding-top: 68px;
    padding-bottom: 64px;
  }

  .hero-copy { max-width: 670px; }
  .eyebrow { color: var(--cyan); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { max-width: 720px; margin: 20px 0; font-size: clamp(3.2rem, 6vw, 5.8rem); line-height: 0.98; letter-spacing: -0.055em; }
  .lead { max-width: 600px; color: var(--muted); font-size: 1.1rem; line-height: 1.75; }
  .button-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .stats { display: flex; flex-wrap: wrap; gap: 30px; margin-top: 38px; }
  .stats div { display: grid; gap: 4px; }
  .stats strong { font-size: 1.65rem; }
  .stats span { color: var(--muted); font-size: 0.84rem; }
  .hero-visual { min-height: 350px; padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(145deg, rgba(139, 92, 246, 0.2), rgba(15, 23, 42, 0.82) 54%, rgba(34, 211, 238, 0.12)); box-shadow: 0 30px 80px rgba(2, 6, 23, 0.35); }
  .visual-top { display: flex; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .visual-top span:first-child { color: var(--cyan); letter-spacing: 0.25em; }
  .visual-grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 14px; padding-top: 18px; }
  .chart { min-height: 240px; border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(180deg, rgba(139, 92, 246, 0.2), transparent), linear-gradient(145deg, transparent 48%, rgba(34, 211, 238, 0.18)); clip-path: polygon(0 45%, 18% 52%, 34% 38%, 52% 57%, 70% 28%, 100% 12%, 100% 100%, 0 100%); }
  .metrics { display: grid; gap: 14px; }
  .metrics div { display: flex; flex-direction: column; justify-content: center; gap: 10px; min-height: 110px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; background: rgba(15, 23, 42, 0.75); }
  .metrics span { color: var(--muted); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .metrics strong { font-size: 1.6rem; }
  .home-links { padding-top: 10px; padding-bottom: 72px; }
  .home-links a { display: grid; grid-template-columns: 150px 1fr 24px; align-items: center; gap: 18px; padding: 20px 0; border-top: 1px solid var(--line); }
  .home-links a:last-child { border-bottom: 1px solid var(--line); }
  .home-links a > span:first-child { color: var(--cyan); font-size: 0.78rem; letter-spacing: 0.07em; text-transform: uppercase; }
  .home-links strong { font-size: 1.05rem; }
  .arrow { color: var(--cyan); text-align: right; }

  @media (max-width: 820px) {
    .hero { min-height: auto; grid-template-columns: 1fr; gap: 34px; padding-top: 56px; }
    .hero-visual { min-height: 300px; }
  }

  @media (max-width: 520px) {
    .visual-grid { grid-template-columns: 1fr; }
    .chart { min-height: 160px; }
    .metrics { grid-template-columns: 1fr 1fr; }
    .metrics div { min-height: 96px; padding: 12px; }
    .home-links a { grid-template-columns: 1fr 24px; gap: 8px; }
    .home-links a > span:first-child { grid-column: 1; }
    .home-links strong { grid-column: 1; }
    .home-links .arrow { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
