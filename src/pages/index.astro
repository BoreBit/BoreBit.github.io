---
import SiteLayout from '../layouts/SiteLayout.astro';
import art1 from '../../assets/UE/taraash-mittal-screenshot-2026-06-19-194652.webp';
import art2 from '../../assets/Blender/taraash-mittal-henfield1.webp';
import art3 from '../../assets/Designer/taraash-mittal-marble.webp';
import art4 from '../../assets/UE/taraash-mittal-image.webp';
const artwork = [art1, art2, art3, art4];
const links = [['01', 'About us', '/about'], ['02', 'Previous work', '/work'], ['03', 'Showcase', '/showcase'], ['04', 'Current projects', '/projects'], ['05', 'Community', '/community']];
---
<SiteLayout title="BoreBit Labs | Ideas made real" description="BoreBit Labs is an independent creative studio making animation, games, and interactive experiences.">
  <section class="landing" aria-labelledby="landing-title">
    <div class="landing-copy"><p class="landing-label">Independent creative studio ? Ideas in motion</p><h1 id="landing-title">Bore<span>Bit.</span></h1><p>We create worlds, stories and experiences that move people.<br />A little imagination goes a long way.</p></div>
    <div class="art-window" aria-label="A selection of BoreBit artwork"><div class="art-track">{[...artwork, ...artwork].map((art, i) => <div class="art-frame" aria-hidden={i >= artwork.length ? 'true' : undefined}><img src={art.src} alt={i >= artwork.length ? '' : 'BoreBit artwork ' + (i + 1)} /></div>)}</div></div>
    <a class="discover" href="#discover">Discover us <span aria-hidden="true">?</span></a>
  </section>
  <section class="explore" id="discover" data-character-stage aria-labelledby="explore-title">
    <div class="explore-heading"><span>THE WORLD OF BOREBIT</span><h2 id="explore-title">Come a little<br /><em>closer.</em></h2></div>
    <div class="character-wrap"><div class="character-orbit"></div><div class="character-canvas" data-character-canvas aria-hidden="true"></div><p class="character-status" data-character-status></p></div>
    <nav class="radial-nav" aria-label="Explore BoreBit">{links.map(([number, label, href]) => <a href={href}><span>{number}</span><strong>{label}</strong><b aria-hidden="true">?</b></a>)}</nav>
  </section>
</SiteLayout>
<script>
  import { mountHeroCharacter } from '../scripts/heroCharacter';
  const stage = document.querySelector<HTMLElement>('[data-character-stage]');
  if (stage) mountHeroCharacter(stage);
</script>
<style>
.landing{min-height:calc(100svh - 76px);display:grid;grid-template-columns:1fr 47%;position:relative;overflow:hidden;background:#f5f1e5}.landing-copy{align-self:center;padding:5vw 5vw 8vw 8vw;z-index:1}.landing-label,.explore-heading>span{font-size:.7rem;letter-spacing:.18em;font-weight:700;text-transform:uppercase;color:#8a806c}.landing h1{font-size:clamp(5rem,11vw,11rem);letter-spacing:-.09em;line-height:.9;margin:24px 0}.landing h1 span{color:#d4a800}.landing-copy>p:last-child{font-size:clamp(1rem,1.4vw,1.25rem);line-height:1.7;color:#696456}.art-window{height:calc(100svh - 76px);min-height:550px;overflow:hidden;transform:rotate(4deg) scale(1.12);margin-left:4vw}.art-track{display:flex;flex-direction:column;gap:16px;animation:gallery 22s linear infinite}.art-frame{height:37vh;min-height:250px;flex:none;overflow:hidden;background:#ded8c7}.art-frame img{width:100%;height:100%;object-fit:cover;display:block}@keyframes gallery{to{transform:translateY(calc(-50% - 8px))}}.discover{position:absolute;bottom:32px;left:8vw;z-index:2;font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.discover span{display:inline-grid;place-items:center;margin-left:12px;width:35px;height:35px;border:1px solid #aaa18a;border-radius:50%;transition:transform .2s}.discover:hover span{transform:translateY(5px)}
.explore{position:relative;min-height:800px;background:#faf9f4;overflow:hidden;scroll-margin-top:76px}.explore-heading{position:absolute;top:11%;left:7%;z-index:2}.explore-heading h2{font-size:clamp(2.7rem,5vw,5rem);line-height:1;letter-spacing:-.06em;margin:16px 0}.explore-heading em{font-style:normal;color:#d4a800}.character-wrap{position:absolute;left:0;bottom:0;width:55%;height:80%}.character-canvas{position:absolute;inset:0}.character-canvas :global(canvas){display:block;width:100%;height:100%}.character-orbit{position:absolute;width:min(70%,500px);aspect-ratio:1;border:1px solid #e5deca;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);box-shadow:0 0 0 55px #f8f5e9,0 0 0 56px #eee8d8}.character-status{position:absolute;bottom:5%;left:25%;color:#777}.radial-nav{position:absolute;left:55%;right:8%;top:15%;bottom:15%;display:flex;flex-direction:column;justify-content:space-between}.radial-nav a{display:flex;align-items:center;gap:20px;padding:19px 22px;border:1px solid #e6dfcf;background:white;box-shadow:0 12px 35px #35301b0a;transition:transform .2s,background .2s}.radial-nav a:nth-child(1),.radial-nav a:nth-child(5){margin-left:0;margin-right:20%}.radial-nav a:nth-child(2),.radial-nav a:nth-child(4){margin-left:12%;margin-right:8%}.radial-nav a:nth-child(3){margin-left:18%}.radial-nav a:hover{transform:translateX(8px);background:#fff3b6}.radial-nav span{color:#a99c79;font-size:.7rem}.radial-nav b{margin-left:auto;font-size:1.2rem}
@media(max-width:700px){.landing{min-height:calc(100svh - 68px);grid-template-columns:1fr}.landing-copy{align-self:start;padding:12vh 7% 0}.landing h1{font-size:clamp(5rem,20vw,8rem)}.art-window{position:absolute;right:-12%;bottom:0;width:65%;height:45%;min-height:0;opacity:.9}.art-frame{height:180px;min-height:0}.discover{left:7%;bottom:30px}.explore{min-height:1050px}.explore-heading{top:6%}.character-wrap{top:15%;bottom:auto;width:100%;height:440px}.radial-nav{top:590px;bottom:55px;left:7%;right:7%;gap:10px}.radial-nav a:nth-child(n){margin:0}.radial-nav a{padding:15px 18px}}
@media(prefers-reduced-motion:reduce){.art-track{animation:none}.discover span,.radial-nav a{transition:none}}
</style>
