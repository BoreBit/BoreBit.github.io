---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Contact | BoreBit Labs" description="Tell BoreBit Labs what you're making and start a project conversation.">
  <section class="container page-heading contact-heading">
    <div class="eyebrow">Start a conversation</div>
    <h1>Ready to build your next world?</h1>
    <p>Tell us what you’re making, and we’ll shape the creative path forward.</p>
    <a class="button primary" href="mailto:hello@borebitlabs.com">Email hello@borebitlabs.com</a>
  </section>
</SiteLayout>

<style>
  .contact-heading { min-height: 540px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .contact-heading .button { margin-top: 28px; }
</style>